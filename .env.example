# Copy to .env (which is gitignored) and fill in.

# Required: the server binds 0.0.0.0 inside the container, so it always
# needs a token — see the "Docker" section of the README for why.
# Generate one with: openssl rand -hex 24
YAMO_TOKEN=

# Where your music actually lives on the host. Read-write: the API edits
# tags in these files.
MUSIC_DIR=./music

# Optional. Raises the Discogs cover-lookup rate limit from 25 to 60
# requests/minute; leave blank and lookups still work, just slower.
YAMO_DISCOGS_TOKEN=
