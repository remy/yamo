# Copy to .env (which is gitignored) and fill in.

# Required: the server binds 0.0.0.0 inside the container, so it always
# needs a token — see the "Docker" section of the README for why.
# Generate one with: openssl rand -hex 24
YAMO_TOKEN=

# The user the container runs as. The image's own default is uid 65532
# (distroless "nonroot"), which owns nothing on your host, so leave these set
# to the account that owns ./data and your music — `id -u` and `id -g` — or
# the catalogue cannot be written.
PUID=1000
PGID=1000

# Where your music actually lives on the host. Read-write: the API edits
# tags in these files.
MUSIC_DIR=./music

# Optional. How often the server rescans MUSIC_DIR — 1h, 30m. Nothing watches
# the filesystem, so music copied in is invisible until a scan runs; leave it
# blank and the only scan is the one on startup. A minute is the minimum.
YAMO_RESCAN_EVERY=

# Optional. Raises the Discogs cover-lookup rate limit from 25 to 60
# requests/minute; leave blank and lookups still work, just slower.
YAMO_DISCOGS_TOKEN=
